# FiApp — variables de entorno (ejemplo)
# Copia este archivo a .env (no versionar secretos reales).

# URL base de FastAPI para dart-define. En Android Emulator usa 10.0.2.2.
API_BASE_URL=http://10.0.2.2:8000

# Entorno: development | staging | production
APP_ENV=development

# Tiempo de espera HTTP (segundos)
API_CONNECT_TIMEOUT_SECONDS=15
API_RECEIVE_TIMEOUT_SECONDS=15

# El backend usa estas variables en backend/.env, no en el cliente Flutter.
# SUPABASE_URL=https://project.supabase.co
# SUPABASE_ANON_KEY=replace-with-publishable-key
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
