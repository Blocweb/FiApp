# FiApp — variables de entorno (ejemplo)
# Copia este archivo a .env (no versionar secretos reales).

# URL base de la API ASP.NET Core
API_BASE_URL=https://localhost:5001/api

# Entorno: development | staging | production
APP_ENV=development

# Tiempo de espera HTTP (segundos)
API_CONNECT_TIMEOUT_SECONDS=15
API_RECEIVE_TIMEOUT_SECONDS=15

# Feature flags
USE_MOCK_REPOSITORIES=true
