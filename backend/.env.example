# Runtime configuration for the FastAPI container.
APP_ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database
SUPABASE_URL=https://project.supabase.co
SUPABASE_ANON_KEY=replace-with-publishable-key
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SQL_ECHO=false

# Server-only key, never in the Flutter app. Required by POST /usuarios/ to
# create worker accounts through the Supabase Admin API (HU01).
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key