# Client-safe configuration only. Never put backend service-role credentials here.
SUPABASE_URL=https://project.supabase.co
SUPABASE_ANON_KEY=replace-with-publishable-key

# Android Emulator -> host machine. Use API_URL or API_BASE_URL via dart-define
# to override this value for another environment.
